# ---------------------------------------------------------------------------
# ClinicFlow — example environment file
# Copy to server/.env for the API, and to .env.local for the Vite frontend.
# NEVER commit a real .env. NEVER put Hostinger credentials in Git.
# ---------------------------------------------------------------------------

APP_ENV=local                      # local | production
APP_DEBUG=true                     # false in production
APP_NAME=ClinicFlow
APP_URL=http://localhost:5173
API_URL=http://localhost:8000/api

# Generate with: php scripts/genkey.php
APP_KEY=
SESSION_SECRET=

# Session / cookies
SESSION_COOKIE_NAME=clinicflow_session
SESSION_COOKIE_SECURE=false        # true in production (HTTPS only)
SESSION_COOKIE_SAMESITE=Lax
SESSION_ABSOLUTE_MINUTES=720       # 12 h hard limit
SESSION_IDLE_MINUTES=120           # 2 h inactivity limit

# Database (MySQL 8 / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinicflow
DB_USER=clinicflow
DB_PASSWORD=

# Storage (outside the web root in production)
STORAGE_PATH=./storage

# CORS — dev only. Leave EMPTY in production (same-origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (Vite) — only VITE_* variables are exposed to the browser.
# Put these in .env.local at the repo root.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=ClinicFlow

# ---------------------------------------------------------------------------
# Production example (server/.env on Hostinger, chmod 600):
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://clinic.drawlead.com
#   API_URL=https://clinic.drawlead.com/api
#   SESSION_COOKIE_SECURE=true
#   DB_HOST=localhost
#   DB_NAME=u000000000_clinicflow
#   DB_USER=u000000000_clinic
#   DB_PASSWORD=<from hPanel>
#   CORS_ALLOWED_ORIGINS=
#   STORAGE_PATH=/home/u000000000/domains/clinic.drawlead.com/storage
# ---------------------------------------------------------------------------
